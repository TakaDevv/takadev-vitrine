# Laisser vide dans le site publié.
# En développement, le formulaire utilise un aperçu local qui ne transmet rien.
# Pour un envoi réel, indiquer une URL HTTPS qui accepte POST JSON et répond 2xx.
# Ne jamais y placer de mot de passe.
VITE_CONTACT_ENDPOINT=

# Laisser vide tant que le nom de domaine n’est pas confirmé.
# Exemple, une fois le domaine connu : https://www.exemple.dz
# Active alors l’URL canonique et le sitemap. Ne pas inventer de domaine.
VITE_SITE_URL=
